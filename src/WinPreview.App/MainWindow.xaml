<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinPreview.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinPreview.Views"
    xmlns:local="using:WinPreview">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Title bar + main toolbar ===== -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Padding="8,0,0,0" ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="40" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionColumn" Width="138" />
            </Grid.ColumnDefinitions>

            <Button x:Name="SidebarButton" Style="{StaticResource ToolButtonStyle}" Click="SidebarButton_Click" ToolTipService.ToolTip="Show or hide the sidebar (Ctrl+Alt+S)" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE90C;" FontSize="16" />
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,12,0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image Source="ms-appx:///Assets/AppIcon.png" Width="16" Height="16" />
                    <TextBlock x:Name="TitleText" Text="Win-Preview" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                </StackPanel>
                <TextBlock x:Name="SubtitleText" FontSize="11" Opacity="0.7" Margin="24,0,0,0" />
            </StackPanel>

            <Border x:Name="DragRegion" Grid.Column="2" Background="Transparent" />

            <StackPanel x:Name="MainToolbar" Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolButtonStyle}" Click="Inspector_Click" ToolTipService.ToolTip="Document info (Ctrl+I)">
                    <FontIcon Glyph="&#xE946;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource ToolButtonStyle}" Click="ZoomOut_Click" ToolTipService.ToolTip="Zoom out (Ctrl+−)">
                    <FontIcon Glyph="&#xE71F;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource ToolButtonStyle}" Click="ZoomIn_Click" ToolTipService.ToolTip="Zoom in (Ctrl+=)">
                    <FontIcon Glyph="&#xE8A3;" FontSize="16" />
                </Button>
                <Button Style="{StaticResource ToolButtonStyle}" Click="Share_Click" ToolTipService.ToolTip="Share">
                    <FontIcon Glyph="&#xE72D;" FontSize="16" />
                </Button>
                <ToggleButton x:Name="MarkupToggle" Style="{StaticResource ToolToggleStyle}" Click="MarkupToggle_Click" ToolTipService.ToolTip="Show Markup Toolbar (Ctrl+Shift+A)">
                    <FontIcon Glyph="&#xEDFB;" FontSize="16" />
                </ToggleButton>
                <Button Style="{StaticResource ToolButtonStyle}" Click="RotateLeft_Click" ToolTipService.ToolTip="Rotate left (Ctrl+L)">
                    <FontIcon Glyph="&#xE7AD;" FontSize="16" RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </Button>
                <SplitButton x:Name="HighlightButton" Click="HighlightButton_Click" Padding="6,4" ToolTipService.ToolTip="Highlight text" Background="Transparent" BorderBrush="Transparent">
                    <FontIcon x:Name="HighlightIcon" Glyph="&#xE7E6;" FontSize="16" />
                    <SplitButton.Flyout>
                        <MenuFlyout x:Name="HighlightMenu" Placement="Bottom" />
                    </SplitButton.Flyout>
                </SplitButton>
                <AutoSuggestBox x:Name="SearchBox" Width="200" PlaceholderText="Search" QueryIcon="Find" VerticalAlignment="Center"
                                QuerySubmitted="SearchBox_QuerySubmitted" TextChanged="SearchBox_TextChanged" Margin="6,0,4,0" />
                <Button Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="More">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="MoreMenu" Placement="BottomEdgeAlignedRight" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Markup toolbar ===== -->
        <Border x:Name="MarkupBar" Grid.Row="1" Visibility="Collapsed" Padding="8,4"
                Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto">
                <StackPanel x:Name="MarkupTools" Orientation="Horizontal" Spacing="2" />
            </ScrollViewer>
        </Border>

        <!-- ===== Body ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="Sidebar" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <SelectorBar x:Name="SidebarSelector" SelectionChanged="SidebarSelector_SelectionChanged" Margin="2,0">
                    <SelectorBarItem x:Name="ThumbsTab" ToolTipService.ToolTip="Thumbnails (Ctrl+Alt+2)" IsSelected="True">
                        <SelectorBarItem.Icon><FontIcon Glyph="&#xE8A9;" /></SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Name="TocTab" ToolTipService.ToolTip="Table of Contents (Ctrl+Alt+3)">
                        <SelectorBarItem.Icon><FontIcon Glyph="&#xE8FD;" /></SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Name="NotesTab" ToolTipService.ToolTip="Highlights and Notes (Ctrl+Alt+4)">
                        <SelectorBarItem.Icon><FontIcon Glyph="&#xE7E6;" /></SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Name="ResultsTab" ToolTipService.ToolTip="Search Results">
                        <SelectorBarItem.Icon><FontIcon Glyph="&#xE721;" /></SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>

                <ListView x:Name="ThumbList" Grid.Row="1" SelectionMode="Extended" CanReorderItems="True" AllowDrop="True" CanDragItems="True"
                          IsItemClickEnabled="True" ItemClick="ThumbList_ItemClick" SelectionChanged="ThumbList_SelectionChanged"
                          DragItemsCompleted="ThumbList_DragItemsCompleted" DragOver="ThumbList_DragOver" Drop="ThumbList_Drop"
                          KeyDown="ThumbList_KeyDown" RightTapped="ThumbList_RightTapped" Padding="0,8">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ThumbItem">
                            <StackPanel HorizontalAlignment="Center" Padding="0,6" Spacing="4">
                                <Border Background="White" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        Width="{x:Bind DisplayWidth, Mode=OneWay}" Height="{x:Bind DisplayHeight, Mode=OneWay}">
                                    <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{x:Bind Label, Mode=OneWay}" HorizontalAlignment="Center" FontSize="11" Opacity="0.8" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <TreeView x:Name="TocTree" Grid.Row="1" Visibility="Collapsed" ItemInvoked="TocTree_ItemInvoked" SelectionMode="Single" />

                <ListView x:Name="NotesList" Grid.Row="1" Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="NotesList_ItemClick" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:NoteItem">
                            <Grid Padding="0,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Fill="{x:Bind Swatch}" RadiusX="2" RadiusY="2" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Header}" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" MaxLines="4" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid x:Name="ResultsPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ResultsHeader" Margin="12,8" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                    <ListView x:Name="ResultsList" Grid.Row="1" IsItemClickEnabled="True" ItemClick="ResultsList_ItemClick" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ResultItem">
                                <StackPanel Padding="0,6">
                                    <TextBlock Text="{x:Bind Header}" FontSize="11" Opacity="0.7" />
                                    <TextBlock Text="{x:Bind Context}" TextWrapping="Wrap" MaxLines="3" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Page actions: add and remove pages -->
                <Border x:Name="PageActions" Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="6,4">
                    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                        <DropDownButton x:Name="AddPageButton" Style="{StaticResource ToolButtonStyle}" ToolTipService.ToolTip="Add a page">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock x:Name="AddPageLabel" Text="Add Page" FontSize="12" />
                                <FontIcon Glyph="&#xE70D;" FontSize="8" VerticalAlignment="Center" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="AddPageMenu" Placement="TopEdgeAlignedLeft" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button x:Name="RemovePageButton" Style="{StaticResource ToolButtonStyle}" Click="RemovePage_Click" ToolTipService.ToolTip="Remove the selected pages (Delete)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE738;" FontSize="14" />
                                <TextBlock x:Name="RemovePageLabel" Text="Remove" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <views:DocumentView x:Name="DocView" Grid.Column="1" />

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="96" Height="96" />
                <TextBlock Text="Open a PDF or image to get started" FontSize="18" HorizontalAlignment="Center" />
                <TextBlock Text="Drop files here, or" Opacity="0.7" HorizontalAlignment="Center" />
                <Button Content="Open…" Click="Open_Click" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" MinWidth="120" />
            </StackPanel>

            <InfoBar x:Name="Info" Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16" MaxWidth="560" IsOpen="False" />
        </Grid>
    </Grid>
</Window>
