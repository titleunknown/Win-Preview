<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WinPreview</RootNamespace>
    <AssemblyName>WinPreview</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Required so 'dotnet publish' includes WinPreview.pri (XAML resources) for this unpackaged app. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Keep the release download small (GitHub caps files at 100 MB). Partial trimming only trims assemblies that opt in
       (the .NET runtime and the Windows SDK projection); our own code is kept whole, so reflection over app types
       (System.Text.Json settings, XAML) keeps working. -->
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <!-- Only the Windows App SDK components we use, instead of the Microsoft.WindowsAppSDK metapackage, which also
         pulls in Windows ML (DirectML + a second onnxruntime), Windows AI and Widgets that we never load. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="1.8.25122902" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinPreview.Core\WinPreview.Core.csproj" />
    <!-- Native cursor resources: not referenced as code, just copied next to the app (see Views/AppCursors.cs). -->
    <ProjectReference Include="..\WinPreview.Resources\WinPreview.Resources.csproj" ReferenceOutputAssembly="false"
                      OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Models\u2netp.onnx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
