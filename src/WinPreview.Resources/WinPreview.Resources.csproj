<Project Sdk="Microsoft.NET.Sdk">
  <!-- A resource-only library: it exists so the mouse cursors (zoom, hand) can be embedded as native Win32 resources,
       which WinUI loads with InputCursor.CreateFromModule. Regenerate Cursors.res with tools/CursorGen. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WinPreview.Cursors</AssemblyName>
    <RootNamespace>WinPreview.Resources</RootNamespace>
    <Win32Resource>Cursors.res</Win32Resource>
  </PropertyGroup>
</Project>
